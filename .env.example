# Copy this file to .env (same folder) and fill in only the keys you use.
# .env is git-ignored; never commit real keys. Variables already set in your
# shell override the values below.

# --- LLM provider: set the one matching llm.provider in your config --------
# openai_compatible (llm.base_url endpoints, e.g. configs/neuroii_qwen.yaml).
# Only sent to llm.base_url; hosted keys below are never sent there.
FACTORMINER_COMPAT_API_KEY=
# google (default provider in configs/default.yaml)
GOOGLE_API_KEY=
# openai
OPENAI_API_KEY=
# anthropic
ANTHROPIC_API_KEY=
# deepseek
DEEPSEEK_API_KEY=
# Optional: key for the cheap draft model when llm.cascade is enabled
FACTORMINER_DRAFT_API_KEY=

# --- Langfuse tracing (optional; Settings -> API Keys in your project) ------
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# EU cloud: https://cloud.langfuse.com  US cloud: https://us.cloud.langfuse.com
LANGFUSE_BASE_URL=https://cloud.langfuse.com
